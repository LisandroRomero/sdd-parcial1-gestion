# API Configuration
# Backend API base URL - points to the FastAPI server
VITE_API_BASE_URL=http://localhost:8000/api/v1

# MercadoPago Configuration
# Get this from your MercadoPago dashboard: https://www.mercadopago.com/developers/panel
# Use TEST- prefix for sandbox/development environment
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key

# Application Environment
# Options: development, staging, production
VITE_ENVIRONMENT=development
