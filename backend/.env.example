# Database Configuration
# PostgreSQL connection string format: postgresql://user:password@localhost:5432/database_name
DATABASE_URL=postgresql://foodstore_user:foodstore_pass@localhost:5432/foodstore_dev

# JWT Configuration
# Secret key for signing JWT tokens (use a strong random string in production)
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT Access Token expiration time in minutes (default: 30 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT Refresh Token expiration time in days (default: 7 days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# Format: http://localhost:3000,http://localhost:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MercadoPago Configuration
# Get these from your MercadoPago dashboard: https://www.mercadopago.com/developers/panel
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key

# Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# Optional: Admin user credentials for initial seed (used when creating admin user)
ADMIN_EMAIL=admin@foodstore.local
ADMIN_PASSWORD=AdminPassword123!
