# Backend environment variables (template)

# App
APP_NAME="Food Store API"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg://foodstore:foodstore@localhost:5432/foodstore"

# Auth (placeholders; implemented in auth feature)
SECRET_KEY="CHANGE_ME_USE_A_LONG_RANDOM_STRING"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
# Pydantic parses JSON arrays for list[str]. Example:
# CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'
CORS_ORIGINS='["http://localhost:5173"]'

# MercadoPago (placeholders)
MERCADOPAGO_ACCESS_TOKEN="TEST_ACCESS_TOKEN"
MERCADOPAGO_WEBHOOK_SECRET=""
